{
  "name": "aiutodoc",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-local.js",
    "build": "node scripts/build-netlify.js",
    "check": "node scripts/check-project.cjs",
    "check:clinical-validation": "node aiutodoc-validation/scripts/assert-parallel-branch.cjs && npm run check",
    "build:clinical-validation": "node aiutodoc-validation/scripts/assert-parallel-branch.cjs && npm run build",
    "test": "node --test tests/*.test.cjs",
    "verify": "npm run check && npm test",
    "audit:isolation": "node scripts/check-isolation.cjs"
  },
  "engines": {
    "node": ">=18"
  }
}
