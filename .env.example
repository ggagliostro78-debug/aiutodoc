# Development configuration only. Never copy a production .env or service account.
AIUTODOC_PORT=4284
AIUTODOC_EXTERNAL_SERVICES=false
# Use a dedicated cloud project. Leave empty for local volatile storage.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# At least 64 random characters, server-side only. Local dev uses an ephemeral secret.
AIUTODOC_SIGNING_SECRET=
AIUTODOC_ALLOWED_ORIGIN=
GEMINI_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
SERPAPI_API_KEY=
TRIAGE_RETENTION_DAYS=30
PROVIDER_CALLS_PER_DAY=1000
