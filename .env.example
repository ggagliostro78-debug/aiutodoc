GEMINI_API_KEY=incolla-qui-la-tua-chiave-gemini-server-side

# Ricerca reale Google degli specialisti.
# Creare un motore Programmable Search Engine e abilitare Custom Search JSON API.
GOOGLE_CSE_API_KEY=incolla-qui-la-tua-chiave-google-custom-search
GOOGLE_CSE_ID=incolla-qui-il-tuo-search-engine-id

# Alternativa per nuovi progetti Google: Custom Search JSON API e' chiusa ai nuovi clienti.
# SerpApi restituisce risultati Google reali via API.
SERPAPI_API_KEY=incolla-qui-la-tua-chiave-serpapi

# Google Places API (Nuovo) per trovare medici reali con contatti e rating.
# Se non specificata, il sistema usera' GEMINI_API_KEY (assicurarsi di abilitare "Places API (New)" sulla console GCP)
GOOGLE_PLACES_API_KEY=

# Facoltativo: limita le richieste a un solo dominio frontend.
# Esempio: https://aiutodoc.it
GEMINI_ALLOWED_ORIGIN=

# Facoltativo: quote difensive lato backend per ridurre abusi e costi API.
GEMINI_RATE_LIMIT_PER_MINUTE=20
SEARCH_RATE_LIMIT_PER_MINUTE=30
TRIAGE_RATE_LIMIT_PER_MINUTE=10
TRIAGE_RETENTION_DAYS=30

# Fallback triage: vuoto = usa il motore locale solo se Gemini ha errori recuperabili
# come quota esaurita o indisponibilita temporanea. Impostare false per disabilitarlo.
ALLOW_LOCAL_TRIAGE_FALLBACK=

# Facoltativo: abilita salvataggio e recupero cloud degli ID triage.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Archivio anonimo server-side dei codici recupero.
# Incollare il JSON completo del service account Firebase/Google Cloud in Netlify env.
# Non inserirlo mai in src/config.js o in file pubblici.
FIREBASE_SERVICE_ACCOUNT_JSON=
