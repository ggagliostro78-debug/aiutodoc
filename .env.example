# Beta only. Never copy the production .env or service account.
BETA_PORT=4284
BETA_EXTERNAL_SERVICES=false
# Separate cloud project must end in -beta. Leave empty for local volatile storage.
BETA_FIREBASE_PROJECT_ID=
BETA_FIREBASE_SERVICE_ACCOUNT_JSON=
# At least 64 random characters, server-side only. Local dev uses an ephemeral secret.
BETA_SIGNING_SECRET=
BETA_ALLOWED_ORIGIN=
BETA_GEMINI_API_KEY=
BETA_GOOGLE_PLACES_API_KEY=
BETA_GOOGLE_CSE_API_KEY=
BETA_GOOGLE_CSE_ID=
BETA_SERPAPI_API_KEY=
BETA_TRIAGE_RETENTION_DAYS=30
BETA_PROVIDER_CALLS_PER_DAY=1000
