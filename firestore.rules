rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /registered_users/{userId} {
      allow read, write: if false;
    }

    match /triages/{triageDocId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
